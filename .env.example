# ---------------------------------------------------------------------------
# Rotaract Event Reporting CRM — environment variables
# Copy to `.env` and fill in. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL: Supabase / Neon / local docker) -------------------
DATABASE_URL="postgresql://neondb_owner:npg_f6cFK5TvCLuB@ep-wild-butterfly-ayplqmy6-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Optional direct (non-pooled) URL used by `prisma migrate` on Supabase/Neon
DIRECT_URL="postgresql://neondb_owner:npg_f6cFK5TvCLuB@ep-wild-butterfly-ayplqmy6-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# --- Auth.js ----------------------------------------------------------------
# Generate with:  openssl rand -base64 32
AUTH_SECRET="Vu+W1gc8CzJYNgDdklpI6/eGPqsPtg9RN6gx9gtvESg="
# Public base URL of the deployment (http://localhost:3000 in dev)
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# --- Google OAuth (login AND Google Drive) ----------------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web)
# Authorised redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Google Drive -----------------------------------------------------------
# ID of the Drive folder that will hold ALL club reporting (e.g. "ROTARACT EVENT REPORTS").
# Take it from the folder URL: https://drive.google.com/drive/folders/<THIS_PART>
# Can also be set from the in-app Settings → Google Drive screen.
GOOGLE_DRIVE_ROOT_FOLDER_ID=""
# Optional: use a service account instead of an admin's connected Google account.
# Paste the whole JSON key on one line, or point GOOGLE_SERVICE_ACCOUNT_FILE at the file.
GOOGLE_SERVICE_ACCOUNT_JSON=""
GOOGLE_SERVICE_ACCOUNT_FILE=""
# Shared-drive id, if the root folder lives on a Google Shared Drive.
GOOGLE_DRIVE_ID=""

# --- Local evidence staging -------------------------------------------------
# Uploads land here first, then sync to Drive. Use a persistent volume in prod,
# or an S3-compatible bucket by swapping src/server/storage/local.ts.
UPLOAD_DIR="./.uploads"
MAX_UPLOAD_MB="25"

# --- AI assistance (OPTIONAL — the app works fully without it) --------------
# Any OpenAI-compatible endpoint. Leave blank to hide AI buttons.
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# --- Bootstrapping ----------------------------------------------------------
# Comma-separated emails auto-promoted to SUPER_ADMIN on first Google login.
SUPER_ADMIN_EMAILS="president@example.org"
# Password for the seeded demo accounts (dev only).
SEED_PASSWORD="Rotaract@2026"
